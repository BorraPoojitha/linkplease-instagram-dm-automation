# LinkPlease Environment Configuration Example
# Copy this file to .env and set your secrets. Never commit .env!

PSEUDOGRAM_API_KEY=your_pseudogram_api_key_here
DATABASE_URL=sqlite+aiosqlite:///./linkplease.db
# For PostgreSQL deployment, use:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/linkplease

MAX_RETRIES=5
WORKER_POLL_INTERVAL=1.0
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60.0
PSEUDOGRAM_API_BASE_URL=https://pseudogram-api.onrender.com
